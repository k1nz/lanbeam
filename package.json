{
  "name": "lanbeam",
  "version": "1.0.3",
  "description": "A local-first LAN file transfer and real-time sharing tool",
  "bin": {
    "lanbeam": "./bin/lanbeam.js"
  },
  "files": [
    "bin",
    "client/dist",
    "server/dist",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter server --filter client run dev --host",
    "dev:server": "pnpm --filter server run dev",
    "dev:client": "pnpm --filter client run dev",
    "dev:site": "pnpm --filter site run dev",
    "build": "pnpm --filter client run build && pnpm --filter server run build",
    "build:executable": "pnpm build && esbuild server/dist/index.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist-executable/server.js",
    "package:win": "pnpm build:executable && pkg . --sea --targets node24-win-x64 --output release/lanbeam-win-x64.exe",
    "package:linux:x64": "pnpm build:executable && pkg . --sea --targets node24-linux-x64 --output release/lanbeam-linux-x64",
    "package:macos:x64": "pnpm build:executable && pkg . --sea --targets node24-macos-x64 --output release/lanbeam-darwin-x64",
    "package:macos:arm64": "pnpm build:executable && pkg . --sea --targets node24-macos-arm64 --output release/lanbeam-darwin-arm64",
    "package:all": "pnpm package:linux:x64 && pnpm package:macos:x64 && pnpm package:macos:arm64 && pnpm package:win",
    "prepack": "pnpm build",
    "start": "pnpm --filter server run start",
    "clean": "pnpm --recursive run clean",
    "typecheck": "pnpm --filter server run typecheck && pnpm --filter client run typecheck && tsgo --noEmit -p tsconfig.json",
    "lint": "pnpm --recursive run lint",
    "install:all": "pnpm install",
    "network": "tsgo -p tsconfig.json && node dist/scripts/network-info.js",
    "network:info": "tsgo -p tsconfig.json && node dist/scripts/network-info.js"
  },
  "keywords": [
    "file-transfer",
    "nodejs",
    "react",
    "upload",
    "monorepo"
  ],
  "author": "k1nz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1nz/lanbeam.git"
  },
  "bugs": {
    "url": "https://github.com/k1nz/lanbeam/issues"
  },
  "homepage": "https://github.com/k1nz/lanbeam#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "0.28.1",
    "typescript": "^5.3.0"
  },
  "pkg": {
    "scripts": [
      "dist-executable/**/*.js"
    ],
    "assets": [
      "client/dist/**/*"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
